From: H3 V29/V30 Community Release (local 8207 production patch, captured 2026-11-03)
Subject: [PATCH] timeline: widen port widget range 8188-8199 -> 1-65535

Upstream ComfyUI-MAINodes v1.0.5 (commit b99bb83, 2026-08-23) hardcodes the
timeline port widget range to 8188-8199. The H3 production deployment runs
director backends on ports outside that band (8197/8207), so the widget range
is widened to 1-65535. Defaults are unchanged (8189 / 8188).

Base: upstream v1.0.5 = commit b99bb83 (blob-verified against local 8207
runtime; all other files byte-identical).
Apply: git apply ComfyUI-MAINodes_v1.0.5_timeline_port_range.patch
Verified: git apply --check clean against pristine b99bb83, 2026-11-03.
---
 timeline/nodes.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/timeline/nodes.py b/timeline/nodes.py
index 0000000..0000001 100644
--- a/timeline/nodes.py
+++ b/timeline/nodes.py
@@ -241,7 +241,7 @@
         }, "optional": {
             "graph_path": ("STRING", {"default": "",
                            "tooltip": "empty = workflows/<plan name>.api.json"}),
-            "port": ("INT", {"default": 8189, "min": 8188, "max": 8199,
+            "port": ("INT", {"default": 8189, "min": 1, "max": 65535,
                      "tooltip": "instance the launch line targets, and whose /system_stats the VRAM fit line reads"}),
             "recorder_path": ("STRING", {"default": recorder.DEFAULT_PATH,
                               "tooltip": "flight-recorder jsonl; layer (b) of the price meter calibrates from YOUR runs only"}),
@@ -494,7 +494,7 @@
     @classmethod
     def INPUT_TYPES(cls):
         return _plan_inputs({
-            "port": ("INT", {"default": 8188, "min": 8188, "max": 8199,
+            "port": ("INT", {"default": 8188, "min": 1, "max": 65535,
                      "tooltip": "instance whose /system_stats the VRAM reading comes from"}),
             "recorder_path": ("STRING", {"default": recorder.DEFAULT_PATH,
                               "tooltip": "flight-recorder jsonl; layer (b) calibrates from YOUR runs only"}),

